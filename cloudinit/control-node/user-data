#cloud-config
hostname: av-control-node
manage_etc_hosts: true
package_update: true
package_upgrade: true
ssh_pwauth: true
users:
  - name: ziggi-ubuntu
    gecos: Ziggi Ubuntu
    groups: adm, sudo
    shell: /bin/bash
    lock_passwd: false
    sudo: ALL=(ALL) NOPASSWD:ALL
    plain_text_passwd: "REPLACE_WITH_LOCAL_SEEDED_PASSWORD"
  - name: ziggi-py
    gecos: Ziggi Python Automation
    groups: adm, sudo
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOmjwNUVLGQIWdKeWAtIo1Kzv2WIx7r97Xz+2lmE2xEl ziggi-py-control-host
chpasswd:
  expire: false
packages:
  - ansible-core
  - git
  - python3-venv
  - qemu-guest-agent
  - rsync
  - curl
  - openssh-server
runcmd:
  - systemctl enable --now qemu-guest-agent
  - systemctl enable --now ssh
