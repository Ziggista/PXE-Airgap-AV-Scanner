#!/usr/bin/env bash
set -euo pipefail

STATUS_DIR="/run/av"
STATUS_FILE="$STATUS_DIR/definition-sync.status"
TARGET="/opt/av/definitions/clamav"
BASE_URL="{{ pxe_client_runtime_definitions_base_url }}"

mkdir -p "$STATUS_DIR"
mkdir -p "$TARGET"
echo "running" > "$STATUS_FILE"

fetched=0
for file in main.cvd daily.cvd bytecode.cvd main.cld daily.cld bytecode.cld; do
  if curl -fsSL "$BASE_URL/${file}" -o "$TARGET/${file}"; then
    fetched=1
  fi
done

if [[ "$fetched" -eq 0 ]]; then
  echo "failed" > "$STATUS_FILE"
  echo "Failed to fetch any runtime AV definitions from $BASE_URL" >&2
  exit 1
fi

echo "ready" > "$STATUS_FILE"
