#!/usr/bin/env bash
set -euo pipefail

WORKSPACE="{{ pxe_client_livebuild_root }}"
PUBLISH="{{ pxe_client_publish_dir }}"
CASPER_DIR="$WORKSPACE/binary/casper"

mkdir -p "$PUBLISH"
cp -f "$(find "$CASPER_DIR" -maxdepth 1 -name 'vmlinuz-*' | head -n 1)" "$PUBLISH/vmlinuz"
cp -f "$(find "$CASPER_DIR" -maxdepth 1 -name 'initrd.img-*' | head -n 1)" "$PUBLISH/initrd"
cp -f "$CASPER_DIR/filesystem.squashfs" "$PUBLISH/filesystem.squashfs"

echo "Published PXE client assets into $PUBLISH"
