#!/usr/bin/env bash
set -euo pipefail

APPROVAL_DIR="/run/av-scan"
APPROVAL_FILE="$APPROVAL_DIR/approved"
LATEST_RUN_FILE="$APPROVAL_DIR/latest-run.env"
REQUEST_DIR="$APPROVAL_DIR/requests"
REQUEST_FILE="$REQUEST_DIR/copy.request"
REQUEST_TMP_FILE="$REQUEST_DIR/copy.request.tmp.$$"
REQUEST_SOURCE_PATH="${SOURCE_PATH:-}"
REQUEST_DESTINATION_PATH="${DESTINATION_PATH:-}"

if [[ ! -f "$APPROVAL_FILE" ]]; then
  echo "Writable destination media is blocked until offline scans complete successfully." >&2
  exit 1
fi

if [[ ! -f "$LATEST_RUN_FILE" ]]; then
  echo "No approved scan context was found. Run offline-scan.sh first." >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$LATEST_RUN_FILE"

REQUEST_SOURCE_PATH="${REQUEST_SOURCE_PATH:-${SOURCE_PATH:-/mnt/public-media}}"
REQUEST_DESTINATION_PATH="${REQUEST_DESTINATION_PATH:-${DESTINATION_PATH:-/mnt/approved-media}}"

mkdir -p "$REQUEST_DIR"
trap 'rm -f "$REQUEST_TMP_FILE"' EXIT
cat > "$REQUEST_TMP_FILE" <<EOF
REQUESTED_BY=$(id -un)
REQUESTED_AT=$(date -Iseconds)
SOURCE_PATH=${REQUEST_SOURCE_PATH}
DESTINATION_PATH=${REQUEST_DESTINATION_PATH}
RUN_ID=${RUN_ID:-unknown}
EOF
mv -f "$REQUEST_TMP_FILE" "$REQUEST_FILE"
trap - EXIT
sudo -n /bin/bash /usr/local/bin/copy-approved-media.sh "$REQUEST_SOURCE_PATH" "$REQUEST_DESTINATION_PATH"
rm -f "$REQUEST_FILE"

echo "Approved copy completed through the root-mediated transfer helper."
