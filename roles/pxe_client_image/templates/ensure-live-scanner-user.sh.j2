#!/usr/bin/env bash
set -euo pipefail

scanner_user="{{ pxe_client_username }}"
scanner_home="/home/${scanner_user}"

if ! getent group "${scanner_user}" >/dev/null 2>&1; then
  groupadd "${scanner_user}"
fi

if ! id -u "${scanner_user}" >/dev/null 2>&1; then
  useradd \
    -m \
    -k /etc/skel \
    -s /usr/sbin/nologin \
    -g "${scanner_user}" \
    -G audio,video,input,render \
    "${scanner_user}"
fi
current_shell="$(getent passwd "${scanner_user}" | cut -d: -f7)"
current_groups="$(id -nG "${scanner_user}" 2>/dev/null || true)"
if [[ "${current_shell}" != "/usr/sbin/nologin" ]] \
  || [[ " ${current_groups} " != *" audio "* ]] \
  || [[ " ${current_groups} " != *" video "* ]] \
  || [[ " ${current_groups} " != *" input "* ]] \
  || [[ " ${current_groups} " != *" render "* ]]; then
  usermod -s /usr/sbin/nologin -G audio,video,input,render "${scanner_user}"
fi
chage -I -1 -m 0 -M 99999 -E -1 "${scanner_user}" 2>/dev/null || true
passwd -l "${scanner_user}" 2>/dev/null || true

install -d -m 0700 -o "${scanner_user}" -g "${scanner_user}" \
  "${scanner_home}/.config" \
  "${scanner_home}/.local" \
  "${scanner_home}/.local/share" \
  "${scanner_home}/.local/share/applications" \
  "${scanner_home}/.local/state"

install -d -m 0755 -o "${scanner_user}" -g "${scanner_user}" /var/log/av-pxe
install -d -m 0755 -o "${scanner_user}" -g "${scanner_user}" /var/log/av-pxe/scans
touch /var/log/av-pxe/session.log /var/log/av-pxe/openbox-autostart.log /var/log/av-pxe/banner.log
chown "${scanner_user}:${scanner_user}" \
  /var/log/av-pxe/session.log \
  /var/log/av-pxe/openbox-autostart.log \
  /var/log/av-pxe/banner.log

install -d -m 0755 -o "${scanner_user}" -g "${scanner_user}" /run/av
install -d -m 0755 -o "${scanner_user}" -g "${scanner_user}" /run/av-scan
install -d -m 0730 -o "${scanner_user}" -g "${scanner_user}" /run/av-scan/requests
rm -f /run/av/banner-ready /run/av/post-splash-network-disabled

if [[ -f /etc/skel/.xsession && ! -f "${scanner_home}/.xsession" ]]; then
  install -m 0755 -o "${scanner_user}" -g "${scanner_user}" /etc/skel/.xsession "${scanner_home}/.xsession"
fi
if [[ -f /etc/skel/.xinitrc && ! -f "${scanner_home}/.xinitrc" ]]; then
  install -m 0755 -o "${scanner_user}" -g "${scanner_user}" /etc/skel/.xinitrc "${scanner_home}/.xinitrc"
fi
if [[ -f /etc/skel/.bash_profile && ! -f "${scanner_home}/.bash_profile" ]]; then
  install -m 0644 -o "${scanner_user}" -g "${scanner_user}" /etc/skel/.bash_profile "${scanner_home}/.bash_profile"
fi

if [[ -d /etc/skel/.config ]]; then
  cp -a /etc/skel/.config/. "${scanner_home}/.config/" 2>/dev/null || true
fi
if [[ -d /etc/skel/.local/share/applications ]]; then
  cp -a /etc/skel/.local/share/applications/. "${scanner_home}/.local/share/applications/" 2>/dev/null || true
fi

cat >/var/lib/AccountsService/users/"${scanner_user}" <<'EOF'
[User]
Language=en_AU.UTF-8
Session=av-client-openbox
XSession=av-client-openbox
SystemAccount=false
EOF

chown -R "${scanner_user}:${scanner_user}" "${scanner_home}"
chown root:root /var/lib/AccountsService/users/"${scanner_user}"
chmod 0644 /var/lib/AccountsService/users/"${scanner_user}"
