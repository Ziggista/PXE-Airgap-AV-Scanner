#!/usr/bin/env bash
set -euo pipefail

TARGET="{{ pxe_client_livebuild_root }}/config/includes.chroot/opt/av/definitions/clamav"
mkdir -p "$TARGET"
curl -fsSL "{{ pxe_client_proxy_definitions_base_url }}/clamav/" >/dev/null
for file in main.cvd daily.cvd bytecode.cvd main.cld daily.cld bytecode.cld; do
  if curl -fsSL "{{ pxe_client_proxy_definitions_base_url }}/clamav/${file}" -o "$TARGET/${file}"; then
    echo "Fetched ${file}"
  fi
done
echo "ClamAV definitions staged under $TARGET"
